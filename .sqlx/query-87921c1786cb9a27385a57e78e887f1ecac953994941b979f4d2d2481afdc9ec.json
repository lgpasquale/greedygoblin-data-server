{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT id, name, quality\n          FROM item\n         WHERE id = $1 OR name ILIKE '%' || $2 || '%'\n         ORDER BY id = $1 IS TRUE DESC,\n                  name ILIKE $2 || '%' DESC,\n                  length(name), name, id\n         LIMIT $3\n        ",
