# Copy to .env and fill in. .env is not committed.

# Database
POSTGRES_DB=wow
POSTGRES_USER=wow
# Also used in a URL by the services: avoid characters like @ / : ? # %.
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Used by the Rust services and by sqlx-cli when run on the host.
DATABASE_URL=postgres://wow:change-me@127.0.0.1:5432/wow

# Blizzard API client (https://develop.battle.net/access/clients)
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=

# Collector: regions to scan (comma-separated). Default: eu,us,kr,tw
# REGIONS=eu,us,kr,tw
# Log level (tracing EnvFilter syntax). Default: info
# RUST_LOG=info
